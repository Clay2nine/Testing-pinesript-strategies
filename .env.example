# ── Copy this file to .env and fill in your values ──────────────────────────

# MetaTrader 5 credentials (BlackBull account)
MT5_LOGIN=12345678
MT5_PASSWORD=YourMT5Password
MT5_SERVER=BlackBull-Live         # or BlackBull-Demo
MT5_PATH=                         # leave blank for auto-detect
MT5_TIMEOUT_MS=10000
MT5_MAX_RETRIES=3

# Symbol mapping: TradingView symbol → MT5 symbol (JSON)
MT5_SYMBOL_MAP={"XAUUSD":"XAUUSD"}

# Order settings
DEFAULT_MAGIC=202001
DEVIATION_POINTS=20
USE_SL_TP=true
FILL_MODE=IOC                     # IOC | FOK | RETURN

# Optional webhook HMAC secret (set same string in TradingView alert URL)
WEBHOOK_SECRET=

# Logging
LOG_LEVEL=INFO
