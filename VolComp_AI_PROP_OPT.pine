groupState = "In-Trade State Machine (IN-LONG / IN-SHORT / EXIT)"
stateEnable        = input.bool(true, "Enable trade state machine", group=groupState)
exitOnOpposite     = input.bool(true, "Exit on opposite COACH signal", group=groupState)
exitMode           = input.string("Flip", "On opposite: Flip or Flat", options=["Flip","Flat"], group=groupState)
exitOnDomActFlip   = input.bool(false, "Exit if DOM+ACT flip against position", group=groupState)
exitOnAiFlip       = input.bool(false, "Exit if AI flips against position (50-line)", group=groupState)
enableStateAlerts  = input.bool(true, "Enable STATE alertconditions", group=groupState)

//=============================================================================
