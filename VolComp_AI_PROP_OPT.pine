//@version=6
indicator("VolComp AI+ Coach [PROP-OPT | No-Reversal 5m]", shorttitle="VCAI-PROP", overlay=true, max_labels_count=250, max_lines_count=50, max_boxes_count=30)

// =============================================================================
// PROP TRADING OPTIMISATION NOTES (v1.1 — 20/200 EMA strategy)
// =============================================================================
// CHANGES vs original (all ADDITIVE — no existing setting/feature/AI logic altered):
//   v1.0
//   1. Fast EMA default: 8 -> 20  (aligns with your 20 SMA/200 SMA core strategy)
//   2. [NEW] Candle Body Filter   — rejects doji/indecision bars at entry
//   3. [NEW] ATR Compression Guard — blocks entries when volatility is compressed (chop)
//   4. [NEW] EMA-Touch Proximity Filter — price must be near (not far above) the 20 EMA
//   5. [NEW] HTF Bias Check (15m) — requires 15m DOM to agree with trade direction
//   6. [NEW] Consecutive Momentum Bars — B/NI entries require N rising/falling bars
//   7. [NEW] Prop Entry Quality Label — shows A+ / B+ / SKIP on each signal bar
//   8. [NEW] EMA 20/200 plotted on chart with clear visual
//   v1.1  (this version)
//   9. [FIX] Cleaned all panel glyphs (arrows/check marks) so volume rows render
//            correctly instead of garbled mojibake.
//  10. [NEW] PROP COLUMN: a dedicated panel row + A+/B+ BUY/SELL column that is
//            synced to YOUR required prop volume percentages. It only fires when
//            BOTH the dominant (DOM) and active (ACT) volume % meet your prop
//            buy/sell % thresholds AND the existing A/B/NI signal + quality
//            filters agree. This is the "volume-true" buy/sell column you asked
//            for — it reflects real volume dominance, not just the AI bias.
//  11. [NEW] Prop column alertconditions (A+/B+ buy & sell).
//   All original inputs, logic, alerts, state machine, AI orientation — UNTOUCHED.
// =============================================================================

//=============================================================================
// Preset: Aggressive / Balanced / Custom + AUTO tune (XAU/NAS)
//=============================================================================
groupPreset = "Preset"
tradeStyle = input.string("Aggressive", "Trading style",
     options=["Aggressive","Balanced","Custom (use inputs)"],
     tooltip="Aggressive: more signals/faster flips (M5 scalping). Balanced: cleaner/stricter. Custom: uses the inputs below.",
     group=groupPreset)

autoTuneXN = input.bool(true, "AUTO tune for XAUUSD/NAS100 (Aggressive only)",
     tooltip="When Trading style = Aggressive: adjusts vpiA/relVol thresholds slightly for XAUUSD vs NAS100/US100 feeds. Balanced/Custom unaffected.",
     group=groupPreset)

//=============================================================================
// Inputs (Core)
//=============================================================================
groupVol = "Volume settings"
i_smoothingType = input.string("SMA", "Volume moving average", options=["SMA","EMA","HMA","RMA","WMA"], group=groupVol, inline="ma")
i_volSmaLength  = input.int(20, "", minval=1, group=groupVol, inline="ma")
i_source        = input.source(close, "Source for volume direction", group=groupVol)
i_volThreshold  = input.int(70, "High volume threshold %", maxval=100, minval=1, group=groupVol)
i_volAThreshold = input.int(70, "High active volume threshold %", maxval=100, minval=1, group=groupVol)
i_relVol        = input.bool(false, "Use relative volume", group=groupVol)

groupSource    = "Volume source"
i_symbolBool   = input.bool(false, "Override chart volume with custom symbol volume", group=groupSource)
i_symbolVolume = input.symbol("BTCUSDT", "Symbol for volume data", group=groupSource)

groupTf = "Timeframe settings"
i_tf1 = input.timeframe("1", "LTF for charts <= 30 min", group=groupTf)
i_tf2 = input.timeframe("5", "LTF for charts > 30 min & <= 3 hours", group=groupTf)
i_tf3 = input.timeframe("15", "LTF for charts > 3 hours & <= 8 hours", group=groupTf)
i_tf4 = input.timeframe("60", "LTF for charts > 8 hours & <= 1D", group=groupTf)
i_tf5 = input.timeframe("120", "LTF for charts > 1D & <= 3D", group=groupTf)
i_tf6 = input.timeframe("240", "LTF for charts > 3D", group=groupTf)

//=============================================================================
// AI / ML
//=============================================================================
groupAI         = "AI / ML (Adaptive layer)"
i_aiEnable      = input.bool(true, "Enable AI/ML layer", group=groupAI)
i_aiLearn       = input.bool(true, "Online learning (confirmed bars)", group=groupAI)
i_aiLR          = input.float(0.04, "Learning rate", minval=0.0, maxval=1.0, step=0.01, group=groupAI)
i_aiDecay       = input.float(0.998, "Weight decay", minval=0.90, maxval=1.0, step=0.001, group=groupAI)
i_aiClip        = input.float(3.0, "Weight clamp", minval=0.5, maxval=10.0, step=0.25, group=groupAI)
i_aiBull        = input.int(62, "AI bullish threshold", minval=50, maxval=99, group=groupAI)
i_aiBear        = input.int(38, "AI bearish threshold", minval=1, maxval=50, group=groupAI)

//=============================================================================
// A/B + NI
//=============================================================================
groupAB = "A/B Trades (5m scalp layer)"
i_abEnable      = input.bool(true, "Enable A/B trade signals", group=groupAB)
i_abOnly5m      = input.bool(true, "Only fire on 5m timeframe", group=groupAB)
i_abOnePerBar   = input.bool(true, "One signal per bar (A>B>NI)", group=groupAB)
i_abUseTrend    = input.bool(true, "Use EMA 20/200 trend filter", group=groupAB)
// *** PROP CHANGE #1: Fast EMA default changed from 8 -> 20 to match 20 SMA strategy ***
i_abFastLen     = input.int(20, "Fast EMA (20 = your 20 SMA core)", minval=1, group=groupAB, inline="ema")
i_abSlowLen     = input.int(200, "Slow EMA", minval=1, group=groupAB, inline="ema")
i_abMinRelVol   = input.float(1.1, "Min relative volume", step=0.1, minval=0.0, group=groupAB)
i_abStrongBull  = input.int(66, "A-trade bull bias %", minval=50, maxval=99, group=groupAB)
i_abStrongBear  = input.int(34, "A-trade bear bias %", minval=1, maxval=50, group=groupAB)
i_abMinConfA    = input.int(70, "Min confidence % for A", minval=1, maxval=99, group=groupAB)
i_abMinConfB    = input.int(60, "Min confidence % for B", minval=1, maxval=99, group=groupAB)

groupNI = "Next Intention (Active volume imbalance)"
i_niEnable    = input.bool(true, "Enable Next Intention", group=groupNI)
i_niOnly5m    = input.bool(true, "Only fire on 5m timeframe", group=groupNI)
i_niThr       = input.float(0.08, "vpiA threshold", minval=0.01, maxval=0.60, step=0.01, group=groupNI)
i_niSlopeLen  = input.int(2, "Slope confirmation bars", minval=1, maxval=5, group=groupNI)
i_niMinRelVol = input.float(1.0, "Min rel vol for NI", minval=0.0, step=0.1, group=groupNI)

//=============================================================================
// *** NEW: Prop Entry Quality Filters ***
//=============================================================================
groupProp = "Prop Entry Quality Filters (No-Reversal)"
i_propEnable       = input.bool(true,  "Enable Prop Quality Filters",       group=groupProp, tooltip="Master switch. Disabling reverts to original A/B/NI logic only.")
i_bodyFilterOn     = input.bool(true,  "Candle Body Filter (reject dojis)",  group=groupProp, tooltip="Entry candle body must be >= bodyMinPct % of its ATR. Blocks doji/spinning-top entries that reverse immediately.")
i_bodyMinPct       = input.float(0.20, "Min body size (ATR multiplier)",     group=groupProp, step=0.05, minval=0.05, maxval=1.0, tooltip="Body must be >= this x ATR(14). 0.20 = 20% of ATR. Raise to tighten.")
i_atrCompressOn    = input.bool(true,  "ATR Compression Guard (block chop)", group=groupProp, tooltip="Blocks entries when current ATR is compressed vs its own average — chop environment.")
i_atrCompressLen   = input.int(50,     "ATR compression lookback",           group=groupProp, minval=10, maxval=200, tooltip="Length for ATR SMA to compare against current ATR.")
i_atrCompressRatio = input.float(0.65, "Min ATR ratio to allow entry",       group=groupProp, step=0.05, minval=0.20, maxval=0.99, tooltip="current ATR / ATR-SMA must be >= this. 0.65 = current ATR >= 65% of avg. Raise to require more expansion.")
i_emaTouchOn       = input.bool(true,  "EMA-20 Proximity Filter",            group=groupProp, tooltip="Price must have touched or crossed the 20 EMA within the last N bars (pullback entry). Avoids chasing extended moves.")
i_emaTouchBars     = input.int(6,      "EMA-20 touch lookback bars",         group=groupProp, minval=1, maxval=20, tooltip="If price hasn't been within 1x ATR of EMA-20 in this many bars, skip the signal.")
i_htfBiasOn        = input.bool(true,  "HTF Bias Filter (15m DOM agree)",    group=groupProp, tooltip="Requires the 15m timeframe DOM direction to agree with your trade direction. Prevents trading against the higher timeframe flow.")
i_consBarOn        = input.bool(true,  "Consecutive Momentum Bars (B/NI)",   group=groupProp, tooltip="For B-grade and NI signals: requires N consecutive bars closing in trade direction before entry is valid.")
i_consBarLen       = input.int(2,      "Consecutive bars required (B/NI)",   group=groupProp, minval=2, maxval=4, tooltip="2 = two consecutive bullish/bearish closes required before B or NI signal fires.")
i_showQualityLabel = input.bool(true,  "Show Entry Quality Labels (A+/B+)",  group=groupProp, tooltip="Displays A+ or B+ label above/below signal bars for quick quality assessment.")

//=============================================================================
// *** NEW: Prop Volume % Column (sync to your prop buy/sell percentages) ***
//=============================================================================
groupPropCol = "Prop Volume % Column"
i_propColOn       = input.bool(true, "Show PROP column row + A+/B+ buy/sell", group=groupPropCol, tooltip="Adds a dedicated PROP row to the panel and an A+/B+ BUY/SELL column synced to the volume % your prop rules require.")
i_propBuyReqPct   = input.int(83, "Prop BUY required volume %",  group=groupPropCol, minval=50, maxval=99, tooltip="Both DOM (dominant) AND ACT (active) BUY volume % must be >= this for a prop BUY. Default 83 = the lowest prop buy/sell confidence required by the indicators on your chart.")
i_propSellReqPct  = input.int(83, "Prop SELL required volume %", group=groupPropCol, minval=50, maxval=99, tooltip="Both DOM AND ACT SELL volume % must be >= this for a prop SELL. Default 83 = the lowest prop buy/sell confidence required by the indicators on your chart.")
i_propAPlusReqPct = input.int(88, "Prop A+ grade required volume %", group=groupPropCol, minval=50, maxval=99, tooltip="A-grade signals also need dominant volume % >= this to be flagged A+ (highest conviction). Default 88 keeps A+ above your 83% base requirement.")
i_propColLabels   = input.bool(true, "Plot PROP A+/B+ markers on chart", group=groupPropCol, tooltip="Plot the volume-synced PROP buy/sell markers on the chart (separate from the original A+/B+ labels).")

//=============================================================================
// Coach + Alerts
