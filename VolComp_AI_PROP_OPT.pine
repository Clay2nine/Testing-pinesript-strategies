     group=groupCoach)

alertTiming = input.string("Confirmed (exact)", "Alert timing", options=["Confirmed (exact)","Live preview (intrabar)"], group=groupCoach)
shapeTiming = input.string("Live preview (intrabar)", "Marker timing", options=["Live preview (intrabar)","Confirmed (exact)"], group=groupCoach)

showShapes  = input.bool(true, "Show BUY/SELL markers", group=groupCoach)
tintChartBg = input.bool(false, "Tint chart background by LIVE coach", group=groupCoach)

enableBuySellAlerts   = input.bool(true, "Enable BUY/SELL alertconditions", group=groupCoach)
enableHoldAlerts      = input.bool(false, "Enable HOLD alertconditions", group=groupCoach)
holdAlertMode         = input.string("On change", "HOLD alert mode", options=["On change","Every bar"], group=groupCoach)
enableThresholdAlerts = input.bool(false, "Enable threshold alertconditions", group=groupCoach)

//=============================================================================
